{
    "manifest_version": 3,
    "name": "BMUX",
    "version": "0.9.0",
    "description": "A TMUX-inspired Browser Multiplexer",
    "permissions": [
        "tabs",
        "storage",
        "activeTab",
        "scripting",
        "declarativeNetRequest",
        "webRequest",
        "cookies"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background/main.js"
    },
    "action": {
        "default_title": "BMUX menu — toggle or settings",
        "default_popup": "popup/popup.html"
    },
    "options_ui": {
        "page": "settings/settings.html",
        "open_in_tab": true
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/inspect.js",
                "content/scripts.js",
                "content/commands.js",
                "content/main.js"
            ],
            "css": [
                "content/styles.css"
            ],
            "run_at": "document_end",
            "all_frames": true
        }
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_1",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+Shift+L",
                "mac": "Command+Shift+L"
            },
            "description": "Open the BMUX menu (toggle, settings)"
        },
        "toggle-bmux-mode": {
            "suggested_key": {
                "default": "Alt+Shift+B",
                "mac": "Alt+Shift+B"
            },
            "description": "Toggle BMUX on/off (overlay + Control Mode)"
        }
    }
}