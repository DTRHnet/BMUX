{
    "manifest_version": 3,
    "name": "BMUX",
    "version": "0.1.0",
    "description": "A TMUX-inspired Browser Multiplexer",
    "permissions": [
        "tabs",
        "storage",
        "unlimitedStorage",
        "activeTab",
        "scripting"
    ],
    "background": {
        "service_worker": "background/main.js"
    },
    "action": {
        "default_popup": "popup/index.html",
        "default_title": "BMUX"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/main.js"
            ],
            "css": [
                "content/styles.css"
            ],
            "run_at": "document_end",
            "all_frames": true
        }
    ],
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+Shift+L",
                "mac": "Command+Shift+L"
            },
            "description": "Open BMUX Popup"
        },
        "toggle-bmux-mode": {
            "suggested_key": {
                "default": "Alt+Shift+B",
                "mac": "Alt+Shift+B"
            },
            "description": "Toggle BMUX Control Mode"
        }
    }
}